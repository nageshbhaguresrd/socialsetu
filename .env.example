# GEMINI_API_KEY: from Google AI Studio > API Keys
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SUPABASE_URL: from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL="your-project-url"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: from Supabase project settings > API
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-key"

# RESEND_API_KEY: from resend.com > API Keys
RESEND_API_KEY="your-resend-api-key"

# AGENCY_EMAIL: your work email for lead notifications
AGENCY_EMAIL="your-agency-email"

# CRON_SECRET: Random secret string — add same value to Vercel cron job config
CRON_SECRET="your-random-cron-secret"

# YouTube Data API v3 key from Google Cloud Console
YOUTUBE_API_KEY="your-youtube-api-key"

# RapidAPI key for Instagram scraper
RAPIDAPI_KEY="your-rapidapi-key"

# X/Twitter API Bearer Token from developer.twitter.com
TWITTER_BEARER_TOKEN="your-twitter-bearer-token"

# Telegram Bot Lead Alerts (100% Free - from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# Agency WhatsApp Phone Number (Used across website CTAs and invoice footers)
NEXT_PUBLIC_AGENCY_PHONE="919876543210"

# --- BIZPILOT AI ENVIRONMENT VARIABLES ---
# Gemini Model selection (defaults to gemini-3.8-flash for modern v1beta API)
GEMINI_MODEL="gemini-3.8-flash"

# Razorpay India Payment Gateway (for INR Subscriptions in Paise)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Supabase Service Role Key (Required for server-side transactional RPC & admin telemetry)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
